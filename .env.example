# Copy to .env and fill in. Never commit .env.
# Only VITE_-prefixed values reach the browser bundle — keep secrets unprefixed.

# Public (browser-safe)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only — no VITE_ prefix
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Optional — defaults to gpt-4o
OPENAI_MODEL=

# Demo boss account the app auto-signs-in as (an existing Supabase auth user)
DEMO_BOSS_EMAIL=
DEMO_BOSS_PASSWORD=

# Optional, not a secret: lets a local `bun run dev` load Lovable-hosted assets (the logo)
LOVABLE_PREVIEW_HOST=id-preview--7ab38c37-76ae-42bd-b496-182a61a1753c.lovable.app
