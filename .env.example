# Copy to .env and fill in. Never commit .env.
# Only VITE_-prefixed values reach the browser bundle — keep secrets unprefixed.
#
# The Supabase values are the production project's (Project Settings → API), not the old demo
# project's. For the local stack (`bun run db:start`), `bunx supabase status` prints them.

# Public (browser-safe)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only — no VITE_ prefix
# Bypasses row-level security. Used only for the shared weather cache (and, from D2, worker invites).
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Optional — defaults to gpt-4o
OPENAI_MODEL=
